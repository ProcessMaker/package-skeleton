# ProcessMaker sync target (used by deploy scripts and local tooling).
PM_BASE_URL=__PROCESSMAKER_SERVER__
PM_SYNC_TOKEN=
# Optional: executor id or title for new scripts (the plugin executor, php only).
PM_SCRIPT_EXECUTOR=
# Optional, local HTTPS with a self-signed certificate: a CA file, or PM_INSECURE=1 to skip verification.
PM_CA_BUNDLE=
PM_INSECURE=
